PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/webtienganh
# Khoá ký token: chuỗi ngẫu nhiên dài, KHÔNG dùng giá trị mẫu này. Bắt buộc khi NODE_ENV=production.
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
# Email được cấp quyền quản trị khi đăng ký (cách nhau bằng dấu phẩy).
# Khi phát triển, người đăng ký đầu tiên cũng là quản trị viên. Khi NODE_ENV=production thì KHÔNG,
# và email trong danh sách này chỉ được cấp quyền khi OTP_ENABLED=true.
ADMIN_EMAILS=
# Giới hạn số lần gọi theo IP (đăng nhập, đăng ký, OTP, mở quiz). Mặc định bật; chỉ đặt false khi thử nghiệm.
RATE_LIMIT_ENABLED=true
# Tên miền được phép gọi API từ trình duyệt khi chạy thật, ví dụ https://ten-cua-ban.vercel.app (để trống nếu web và API cùng một tên miền)
CORS_ORIGIN=

# ---- Xác thực email bằng mã OTP khi đăng ký (true/false) ----
OTP_ENABLED=false
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60

# ---- Gửi email qua SMTP (cần khi OTP_ENABLED=true) ----
# Để trống SMTP_HOST khi phát triển thì mã OTP chỉ được in ra cửa sổ chạy server, không gửi email thật.
# Ví dụ Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=ban@gmail.com,
# SMTP_PASS=<Mật khẩu ứng dụng 16 ký tự tạo trong tài khoản Google, KHÔNG phải mật khẩu đăng nhập>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Vở tiếng Anh <ban@gmail.com>"

# ---- Captcha Cloudflare Turnstile ở form đăng ký (true/false) ----
# Lấy khoá tại dash.cloudflare.com, mục Turnstile. Site key công khai, Secret key tuyệt đối giữ kín.
# Muốn thử mà chưa tạo khoá thật: Cloudflare có cặp khoá thử nghiệm (site key bắt đầu bằng 1x000000000000... là loại luôn qua).
# Hãy lấy giá trị đầy đủ trong tài liệu Cloudflare, mục Turnstile > Testing, và dùng đúng cặp site key + secret key cùng loại.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
